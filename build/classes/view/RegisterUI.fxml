<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RegisterUIController"
            prefWidth="600" prefHeight="400"
            style="-fx-background-color: #f2f6fa;">

    <children>
        <VBox alignment="CENTER" spacing="12" prefWidth="320" layoutX="140" layoutY="50"
              style="-fx-background-color: white;
                     -fx-padding: 30;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">
            <children>
                <Label text="Register"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2c3e50;
                              -fx-padding: 0 0 10 0;" />

                <TextField fx:id="Name" promptText="Full Name"
                           style="-fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-border-color: #bdc3c7;
                                  -fx-padding: 8;" />

                <TextField fx:id="txtUsername" promptText="Username"
                           style="-fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-border-color: #bdc3c7;
                                  -fx-padding: 8;" />

                <PasswordField fx:id="txtPassword" promptText="Password"
                               style="-fx-background-radius: 8;
                                      -fx-border-radius: 8;
                                      -fx-border-color: #bdc3c7;
                                      -fx-padding: 8;" />

                <Button text="Register" onAction="#handleRegisterAction"
                        style="-fx-background-color: #3498db;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-padding: 8 20 8 20;" />

                <Button text="Back to Login" onAction="#goToLogin"
                        style="-fx-background-color: #ecf0f1;
                               -fx-text-fill: #2c3e50;
                               -fx-background-radius: 8;
                               -fx-padding: 8 20 8 20;" />

                <Label fx:id="lblStatus" textFill="red"
                       style="-fx-font-size: 12px;" />
            </children>
        </VBox>
    </children>
</AnchorPane>